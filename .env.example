# Database Configuration (MongoDB Atlas URI)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database_name>

# Authentication Security Token
JWT_SECRET=your_jwt_secret_key_here

# Google OAuth 2.0 Credentials (For Deep Link Sign-in)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_PORT=53682

# SMTP Configuration (For password reset mailings)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_specific_password_here
SMTP_SECURE=false
SMTP_FROM=Promos <your_email@gmail.com>

# Custom Deep Link URI Protocol (e.g., promos://)
APP_DEEPLINK_SCHEME=promos
